# Copy to .env.test to point the test suite at a database of its own.
#
# The suite writes rows, so it must not share a database with `npm run dev` or
# `db:seed`. CI does not need this file: it provisions an ephemeral PostgreSQL
# service container and sets DATABASE_URL for the job.
#
# First run:
#   docker compose up -d db
#   docker exec <db container> createdb -U staffora staffora_test
#   DATABASE_URL=postgresql://staffora:staffora_local@localhost:5432/staffora_test npm run db:migrate:deploy -w @staffora/api
#   DATABASE_URL=postgresql://staffora:staffora_local@localhost:5432/staffora_test npm run db:seed -w @staffora/api
#   npm test -w @staffora/api
NODE_ENV=test
DATABASE_URL=postgresql://staffora:staffora_local@localhost:5432/staffora_test
SESSION_SECRET=local-dev-session-secret-at-least-32-characters-long
