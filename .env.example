# Staffora Root Environment Template
# Copy to apps/api/.env and apps/web/.env as needed

# Backend Environment (apps/api/.env)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://staffora:staffora_local@localhost:5432/staffora
SESSION_SECRET=replace-with-at-least-32-characters-in-production

# Frontend Environment (apps/web/.env)
VITE_API_BASE_URL=/api/v1
