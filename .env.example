# Staffora Root Environment Template
# Copy to apps/api/.env and apps/web/.env as needed

# Backend Environment (apps/api/.env)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://staffora:<password-lokal>@localhost:5433/staffora
SESSION_SECRET=<session-secret>  # min. 8 karakter, ada huruf kapital dan karakter khusus

# Frontend Environment (apps/web/.env)
VITE_API_BASE_URL=/api/v1
