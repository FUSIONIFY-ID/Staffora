#!/bin/sh
# Pre-push gate untuk repo Staffora.
# Git menjalankan skrip ini sebelum data dikirim ke remote. Jika salah satu gate gagal, push dibatalkan.
# Aktif setelah: git config core.hooksPath .githooks
# Melewati hook (git push --no-verify) hanya dengan keputusan Tech Lead. Agent tidak boleh melakukannya.

set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# Tes hanya boleh memakai database uji. Tanpa apps/api/.env.test, tes akan memakai DATABASE_URL dari .env (database development).
if [ ! -f apps/api/.env.test ]; then
  echo "pre-push: apps/api/.env.test belum ada. Salin apps/api/.env.test.example ke apps/api/.env.test, isi DATABASE_URL ke database staffora_test, lalu jalankan migrasi dan seed ke database itu."
  echo "pre-push: lihat docs/development/testing-guide.md. Push dibatalkan."
  exit 1
fi

run_gate() {
  echo "pre-push: menjalankan $*"
  if ! "$@"; then
    echo "pre-push: GAGAL di '$*'. Push dibatalkan."
    if [ "$*" = "npm test" ]; then
      echo "pre-push: pastikan database lokal aktif: docker compose up -d db (port 5433), migrasi sudah diterapkan, dan DATABASE_URL menunjuk ke port 5433."
    fi
    exit 1
  fi
}

run_gate npm run lint
run_gate npm run typecheck
run_gate npm test
run_gate npm run build

echo "pre-push: semua gate lulus."
exit 0
